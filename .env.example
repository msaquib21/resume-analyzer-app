# ── Deployment Environment ───────────────────────────────────────────
# Options: "local" (default) or "cloud"
# Set DEPLOYMENT_ENV=cloud on Render, Fly.io, or Railway to auto-route to Groq API.
# When DEPLOYMENT_ENV is unset or "local", the app defaults to local Ollama.
DEPLOYMENT_ENV=local

# ── Cloud Deployment (Required when DEPLOYMENT_ENV=cloud) ────────────
# When DEPLOYMENT_ENV=cloud, GROQ_API_KEY is required in your host secret manager.
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Local Ollama Mode (Default when DEPLOYMENT_ENV=local) ────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# ── Service Architecture ─────────────────────────────────────────────
# Required only when Streamlit and FastAPI are deployed as separate services.
# BACKEND_URL=https://your-api-host.example.com
GITHUB_REPOSITORY_URL=https://github.com/msaquib21/resume-analyzer-app
